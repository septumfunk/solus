# Test: Operator Labyrinth - Testing operator precedence and associativity
# Tests: Operator precedence, associativity, complex expressions, parentheses

io.println("Testing arithmetic precedence:");
assert(2 + 3 * 4 == 14);
assert((2 + 3) * 4 == 20);
assert(10 - 3 + 2 == 9);
assert(10 - (3 + 2) == 5);
assert(20 / 4 * 2 == 10);
assert(20 / (4 * 2) == 2);

io.println("Testing comparison precedence:");
assert(5 + 3 > 2 * 3 == true);
assert((5 + 3 > 2) * 3 == 3);
assert(10 > 5 and 3 < 7 == true);
assert((10 > 5) and (3 < 7) == true);

io.println("Testing logical precedence:");
assert(true or false and false == true);
assert((true or false) and false == false);
assert(false and false or true == true);
assert(false and (false or true) == false);

io.println("Testing mixed precedence:");
var complex1 = 2 + 3 * 4 - 5 / 5;
io.println("2 + 3 * 4 - 5 / 5 = " + str(complex1));
assert(complex1 == 13);

var complex2 = (2 + 3) * (4 - 5) / 5;
io.println("(2 + 3) * (4 - 5) / 5 = " + str(complex2));
assert(complex2 == -1);

io.println("Testing unary operator precedence:");
assert(-5 + 3 == -2);
assert(-(5 + 3) == -8);
assert(!false and true == true);
assert(!(false and true) == true);

io.println("Testing assignment precedence:");
var a = 5;
var b = 10;
var c = a + b;
assert(c == 15);

var x = y = z = 42;
assert(x == 42);
assert(y == 42);
assert(z == 42);

io.println("Testing compound assignment:");
var counter = 10;
counter += 5 * 2;
assert(counter == 20);

counter *= 2 + 1;
assert(counter == 60);

io.println("Testing relational chains:");
assert(1 < 2 and 2 < 3 == true);
assert(1 < 2 < 3 == true);
assert(3 > 2 > 1 == true);
assert(5 >= 5 and 5 <= 5 == true);

io.println("Testing equality precedence:");
assert(1 + 1 == 2 == true);
assert((1 + 1 == 2) == true);
assert(1 + 1 == 2 and 2 + 2 == 4 == true);

io.println("Testing short-circuit precedence:");
var side_effect_count = 0;
var se = [side_effect_count]() {
    side_effect_count += 1;
    true
};

side_effect_count = 0;
var result1 = false and se() or true;
assert(side_effect_count == 0);
assert(result1 == true);

side_effect_count = 0;
var result2 = true or se() and false;
assert(side_effect_count == 0);
assert(result2 == true);

io.println("Testing complex boolean expressions:");
var bool_expr = (true and false) or (true and true);
assert(bool_expr == true);

var bool_expr2 = true and (false or true) and true;
assert(bool_expr2 == true);

var bool_expr3 = (true or false) and (false or true) and (true and true);
assert(bool_expr3 == true);

io.println("Testing nested arithmetic:");
var nested = ((2 + 3) * (4 - 1)) / ((6 / 2) + 2);
io.println("Complex nested: " + str(nested));
assert(nested == 3);

var nested2 = 100 - (50 - (25 - (10 - 5)));
io.println("Nested subtraction: " + str(nested2));
assert(nested2 == 70);

io.println("Testing operator combinations:");
var combo1 = 10 + 5 * 2 - 3 / 3;
assert(combo1 == 19);

var combo2 = (10 + 5) * 2 - 3 / 3;
assert(combo2 == 29);

var combo3 = 10 + 5 * (2 - 3) / 3;
assert(combo3 == 8);

io.println("Testing mixed type operations:");
var mixed1 = 10 + 5.5 * 2;
io.println("10 + 5.5 * 2 = " + str(mixed1) + " (type: " + type(mixed1) + ")");

var mixed2 = (10 + 5.5) * 2;
io.println("(10 + 5.5) * 2 = " + str(mixed2) + " (type: " + type(mixed2) + ")");

io.println("Testing string concatenation precedence:");
var str_concat = "a" + "b" + "c";
assert(str_concat == "abc");

var str_mixed = "num: " + str(5 + 5);
assert(str_mixed == "num: 10");

io.println("Testing ternary-like patterns:");
var ternary1 = true and "yes" or "no";
assert(ternary1 == "yes");

var ternary2 = false and "yes" or "no";
assert(ternary2 == "no");

var ternary3 = 5 > 3 and "greater" or "not greater";
assert(ternary3 == "greater");

io.println("TEST PASSED");
