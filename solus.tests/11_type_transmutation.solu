# Test: Type Transmutation - Testing type conversions and coercion
# Tests: i64, f64, str, type, automatic type coercion, type checking

var int_val = 42;
var float_val = 3.14;
var str_val = "test";
var bool_val = true;
var nil_val = nil;
var err_val = err("error");
var obj_val = {};
var fun_val = [](){};

io.println("Type checking:");
assert(type(int_val) == "i64");
assert(type(float_val) == "f64");
assert(type(str_val) == "str");
assert(type(bool_val) == "bool");
assert(type(nil_val) == "nil");
assert(type(err_val) == "err");
assert(type(obj_val) == "obj");
assert(type(fun_val) == "fun");

io.println("Integer to float:");
var i2f = f64(42);
assert(type(i2f) == "f64");
io.println("f64(42) = " + str(i2f));

io.println("Float to integer:");
var f2i = i64(3.14);
assert(type(f2i) == "i64");
assert(f2i == 3);
io.println("i64(3.14) = " + str(f2i));

var f2i_round_down = i64(9.9);
assert(f2i_round_down == 9);
io.println("i64(9.9) = " + str(f2i_round_down));

io.println("String conversions:");
var int_to_str = str(123);
assert(type(int_to_str) == "str");
assert(int_to_str == "123");

var float_to_str = str(3.14);
assert(type(float_to_str) == "str");

var bool_to_str = str(true);
assert(type(bool_to_str) == "str");

var obj_to_str = str({});
assert(type(obj_to_str) == "str");
io.println("Object as string: " + obj_to_str);

io.println("String to number:");
var str_to_int = i64("456");
assert(type(str_to_int) == "i64");
assert(str_to_int == 456);

var str_to_float = f64("3.14159");
assert(type(str_to_float) == "f64");
io.println("f64('3.14159') = " + str(str_to_float));

io.println("Automatic coercion in operations:");
var mixed1 = 10 + 5.5;
io.println("10 + 5.5 = " + str(mixed1) + " (type: " + type(mixed1) + ")");
assert(type(mixed1) == "i64");

var mixed2 = 5.5 + 10;
io.println("5.5 + 10 = " + str(mixed2) + " (type: " + type(mixed2) + ")");
assert(type(mixed2) == "f64");

var mixed3 = 20 - 7.3;
assert(type(mixed3) == "i64");

var mixed4 = 7.3 - 20;
assert(type(mixed4) == "f64");

var mixed5 = 10 * 2.5;
assert(type(mixed5) == "i64");

var mixed6 = 2.5 * 10;
assert(type(mixed6) == "f64");

var mixed7 = 100 / 4;
assert(type(mixed7) == "i64");
assert(mixed7 == 25);

var mixed8 = 100.0 / 4;
assert(type(mixed8) == "f64");

io.println("Edge case conversions:");
var zero_int = i64(0.9);
assert(zero_int == 0);

var zero_float = f64(0);
assert(type(zero_float) == "f64");

var negative_conv = i64(-5.7);
assert(negative_conv == -5);
io.println("i64(-5.7) = " + str(negative_conv));

var large_int = 9999999999;
var large_float = f64(large_int);
io.println("Large number conversion: " + str(large_float));

var type_guard = [](val, expected_type) {
    type(val) == expected_type
};

assert(type_guard(42, "i64"));
assert(type_guard(3.14, "f64"));
assert(type_guard("test", "str"));
assert(!type_guard(42, "f64"));

var polymorphic = [](x) {
    type(x) == "i64" and x * 2 or
    type(x) == "f64" and x + 1.5 or
    type(x) == "str" and x + "!" or
    "unknown"
};

assert(polymorphic(10) == 20);
assert(polymorphic(5.0) == 6.5);
assert(polymorphic("hello") == "hello!");
assert(polymorphic(true) == "unknown");

io.println("TEST PASSED");
