var cat = {
    fur_color = 'orange' # silly default
    age = 0
    babies = 0
    gender = 'male'

    give_birth = [self]() {
        if self.gender == 'male' or age < 1
            err("You can't do that")
        io.println($'MEOW MEOW KITTENS! {++self.babies}');
    }

    grow_old = [self]()
        self.age += 1/365
};

var jessica = { age = 1, gender = 'female' }.usemeta({ _extend = cat });
jessica.grow_old();
jessica.give_birth();