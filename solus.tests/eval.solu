# eval.solu

val src = "{ meows = 2 paws = 4 }";
val inst = unwrap(eval(src));

assert(type(inst) == "obj");
assert(inst.meows == 2);
assert(inst.paws == 4);

assert(type(123) == "i64");
assert(type(3.14) == "f64");
assert(type("hi") == "str");
assert(type(true) == "bool");

val a = i64(3.9);
assert(a == 3);

val b = f64(7);
assert(b == 7.0);

assert(str(42) == "42");