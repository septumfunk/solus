# object.solu

var o = { a = 1 b = 2, };
assert(o.a == 1);
assert(o.b == 2);

obj.set(o, "weird key", 99);
assert(obj.get(o, "weird key") == 99);

val o2 = o + { c = 3 };
assert(type(o2) == "obj");
assert(o2.c == 3);
assert(type(o.c) == "nil" or o.c == nil);

o += { d = 4 };
assert(o.d == 4);

o -= "d";
assert(type(o.d) == "nil" or o.d == nil);

val arr = { 10, 20, 30, 40 };
assert(obj.len(arr) == 4);

var s = 0;
obj.foreach(arr, [s](v, i) { s += v; });
assert(s == 100);

val m = { x = 2 y = 3 };
var prod = 1;
obj.pairs(m, [prod](k, v) { prod = prod * v; });
assert(prod == 6);