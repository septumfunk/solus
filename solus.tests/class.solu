var f = asm(2) [](x) {
    GUPO 2 0 "type";
    CALL 2 2 0;
    GUPO 1 0 "io";
    GET  1 1 "println";
    CALL 1 1 1;
};
f();

{
    name = "Jessica"
    fav_food = "Meow Mix"
    color = "Brown"
    babies = 0

    give_birth = [self]() {
        self.babies += 1;
        io.println("A kitten is born! That's " + str(self.babies) + " babies!");
    }

    describe = [self]() {
        io.println("My name is " + self.name + ", my fav food is " + self.fav_food +
            ", and my color is " + self.color + "!");
        io.println("I've had " + str(self.babies) + " babies so far.");
    }
}


