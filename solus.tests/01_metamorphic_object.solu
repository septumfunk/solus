# Test: Metamorphic Object - Self-modifying object with metaobject recursion
# Tests: obj.usemeta, obj.meta, obj.set, obj.get, self capture, closures

var metamorph = {
    state = 0
    history = {}
};

var meta = {
    _str = [metamorph]() {
        "MetaMorph<state=" + str(metamorph.state) + ", mutations=" + str(obj.len(metamorph.history)) + ">"
    }
    _call = [metamorph](mutation_func) {
        metamorph.state += 1;
        obj.set(metamorph.history, str(obj.len(metamorph.history)), mutation_func);
        mutation_func(metamorph);
        metamorph
    }
    _get = [metamorph](key) {
        metamorph.state += 1;
        obj.get(metamorph, key)
    }
    _set = [metamorph](key, value) {
        metamorph.state += 1;
        obj.set(metamorph, key, value);
    }
};

obj.usemeta(metamorph, meta);

io.println("Initial: " + str(metamorph));

metamorph([](self) {
    obj.set(self, "power", 100);
});

io.println("After mutation 1: " + str(metamorph));

metamorph([](self) {
    obj.set(self, "power", self.power * 2);
});

io.println("After mutation 2: " + str(metamorph));
io.println("Final power: " + str(metamorph.power));
io.println("Total state changes: " + str(metamorph.state));

var m = obj.meta(metamorph);
io.println("Has meta: " + str(type(m) != "nil"));
io.println("History length: " + str(obj.len(metamorph.history)));

io.println("TEST PASSED");
