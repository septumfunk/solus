# capture.solu

var x = 4;
var add_to_x = [x](a) {
    x += a;
};
add_to_x(2);
assert(x == 6);

var counter = {
    count = 3
    inc = [self]() { self.count += 1; self.count }
    get = [self]() { self.count }
};

assert(counter.get() == 3);
assert(counter.inc() == 4);
assert(counter.inc() == 5);
assert(counter.get() == 5);