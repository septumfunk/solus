# Test: Boundary Breaker - Testing edge cases and boundary conditions
# Tests: Empty collections, nil handling, zero values, boundary conditions

io.println("Testing empty collections:");
var empty_array = {};
assert(obj.len(empty_array) == 0);
assert(obj.members(empty_array) == 0);

var empty_obj = obj.new();
assert(obj.members(empty_obj) == 0);

io.println("Testing nil handling:");
var nil_val = nil;
assert(type(nil_val) == "nil");

var nil_check = [](val) {
    type(val) == "nil" and "is nil" or "not nil"
};

assert(nil_check(nil) == "is nil");
assert(nil_check(0) == "not nil");
assert(nil_check("") == "not nil");

io.println("Testing zero values:");
var zero_int = 0;
var zero_float = 0.0;
assert(zero_int == 0);
assert(type(zero_float) == "f64");

var zero_string = "";
assert(string.len(zero_string) == 0);

io.println("Testing single element collections:");
var single_array = { 42 };
assert(obj.len(single_array) == 1);
assert(single_array[0] == 42);

var single_member = { x = 100 };
assert(obj.members(single_member) == 1);
assert(single_member.x == 100);

io.println("Testing boundary string operations:");
var str_edge = "x";
assert(string.len(str_edge) == 1);

var substr_edge = string.sub(str_edge, 0, 1);
assert(substr_edge == "x");

var empty_sub = string.sub("test", 0, 0);
io.println("Empty substring length: " + str(string.len(empty_sub)));

io.println("Testing boundary math operations:");
assert(math.mini(1, 1) == 1);
assert(math.maxi(1, 1) == 1);
assert(math.minf(1.0, 1.0) == 1.0);
assert(math.maxf(1.0, 1.0) == 1.0);

var same_bounds = math.randi(5, 5);
assert(same_bounds == 5);

io.println("Testing negative number boundaries:");
var neg_int = -2147483648;
var pos_int = 2147483647;
io.println("Large negative: " + str(neg_int));
io.println("Large positive: " + str(pos_int));

assert(math.mini(-100, -1) == -100);
assert(math.maxi(-100, -1) == -1);

io.println("Testing division edge cases:");
var div_by_one = 42 / 1;
assert(div_by_one == 42);

var div_equals_one = 5 / 5;
assert(div_equals_one == 1);

io.println("Testing boolean edge cases:");
var bool_true = true;
var bool_false = false;
assert(bool_true and bool_true == true);
assert(bool_false or bool_false == false);
assert(bool_true or bool_false == true);
assert(bool_false and bool_true == false);

io.println("Testing empty string operations:");
var empty1 = "";
var empty2 = "";
var concat_empty = empty1 + empty2;
assert(concat_empty == "");

var split_empty = string.split("", ",");
io.println("Split empty length: " + str(obj.len(split_empty)));

io.println("Testing single character operations:");
var single_char = "a";
var repeated = string.repeat(single_char, 10);
assert(string.len(repeated) == 10);

var split_single = string.split("a,b,c", ",");
assert(obj.len(split_single) == 3);

io.println("Testing object boundary operations:");
var obj_with_nil_member = { x = nil };
assert(type(obj_with_nil_member.x) == "nil");
assert(obj.members(obj_with_nil_member) == 1);

io.println("Testing loop boundary conditions:");
var zero_iterations = 0;
for var i = 0; i < 0; ++i
    zero_iterations += 1;
assert(zero_iterations == 0);

var one_iteration = 0;
for var i = 0; i < 1; ++i
    one_iteration += 1;
assert(one_iteration == 1);

io.println("Testing conditional boundaries:");
var edge_cond = [](x) {
    x > 0 and "positive" or
    x < 0 and "negative" or
    "zero"
};

assert(edge_cond(1) == "positive");
assert(edge_cond(-1) == "negative");
assert(edge_cond(0) == "zero");

io.println("Testing closure with empty captures:");
var no_capture = []() { 42 };
assert(no_capture() == 42);

var empty_params = [](){ 100 };
assert(empty_params() == 100);

io.println("Testing array index boundaries:");
var arr = { 10, 20, 30 };
assert(arr[0] == 10);
assert(arr[2] == 30);

io.println("Testing string split edge cases:");
var no_delimiter = string.split("hello", ",");
io.println("No delimiter split length: " + str(obj.len(no_delimiter)));

var many_delimiters = string.split("a,b,c,d,e,f,g", ",");
assert(obj.len(many_delimiters) == 7);

io.println("Testing type conversion boundaries:");
var max_int_to_float = f64(2147483647);
io.println("Max int as float: " + str(max_int_to_float));

var large_float = 99999999.99;
var truncated = i64(large_float);
io.println("Large float to int: " + str(truncated));

io.println("Testing object member count:");
var obj_100_members = {};
for var i = 0; i < 100; ++i
    obj.set(obj_100_members, "key_" + str(i), i);

assert(obj.members(obj_100_members) == 100);

io.println("Testing array length:");
var arr_100_elements = {};
for var i = 0; i < 100; ++i
    arr_100_elements += { i };

assert(obj.len(arr_100_elements) == 100);

io.println("TEST PASSED");
