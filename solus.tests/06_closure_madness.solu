# Test: Closure Madness - Deep closure chains and upvalue capture
# Tests: Upvalue capture, closure lifetime, nested functions, var mutation

var create_counter_factory = []() {
    var factory_count = 0;
    
    [factory_count]() {
        factory_count += 1;
        var instance_id = factory_count;
        
        [instance_id]() {
            var count = 0;
            
            {
                id = instance_id
                get = [count]() { count }
                inc = [count]() { count += 1; }
                dec = [count]() { count -= 1; }
                reset = [count]() { count = 0; }
            }
        }
    }
};

var factory = create_counter_factory();
var counter1 = factory()();
var counter2 = factory()();

io.println("Counter 1 ID: " + str(counter1.id));
io.println("Counter 2 ID: " + str(counter2.id));
assert(counter1.id == 1);
assert(counter2.id == 2);

counter1.inc();
counter1.inc();
counter1.inc();
io.println("Counter 1: " + str(counter1.get()));
assert(counter1.get() == 3);

counter2.inc();
io.println("Counter 2: " + str(counter2.get()));
assert(counter2.get() == 1);

counter1.dec();
assert(counter1.get() == 2);

counter1.reset();
assert(counter1.get() == 0);

var cascade_capture = [](initial) {
    var a = initial;
    [a]() {
        var b = a * 2;
        [a, b]() {
            var c = a + b;
            [a, b, c]() {
                var d = a + b + c;
                [a, b, c, d]() {
                    { sum = a + b + c + d }
                }
            }
        }
    }
};

var cascaded = cascade_capture(5)()()()();
io.println("Cascaded sum: " + str(cascaded.sum));
assert(cascaded.sum == 40);

var mutual_capture = []() {
    var x = 0;
    var y = 0;
    
    var inc_x = [x, y]() {
        x += 1;
        y += 2;
    };
    
    var inc_y = [x, y]() {
        y += 1;
        x += 2;
    };
    
    var get_sum = [x, y]() { x + y };
    
    { inc_x = inc_x, inc_y = inc_y, get_sum = get_sum }
};

var mutual = mutual_capture();
mutual.inc_x();
mutual.inc_y();
mutual.inc_x();
io.println("Mutual sum: " + str(mutual.get_sum()));
assert(mutual.get_sum() == 10);

var create_adder = [](base) {
    [base](increment) {
        [base, increment]() { base + increment }
    }
};

var add_to_10 = create_adder(10);
var result = add_to_10(5)();
io.println("Partial application result: " + str(result));
assert(result == 15);

var state_machine = []() {
    var state = "init";
    
    {
        get_state = [state]() { state }
        transition = [state](new_state) { state = new_state; }
    }
};

var sm = state_machine();
assert(sm.get_state() == "init");
sm.transition("running");
assert(sm.get_state() == "running");
sm.transition("stopped");
assert(sm.get_state() == "stopped");

io.println("TEST PASSED");
