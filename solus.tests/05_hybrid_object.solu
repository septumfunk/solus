# Test: Hybrid Object - Testing object array and member components separately
# Tests: obj.len, obj.members, obj.foreach, obj.pairs, object operators

var hybrid = {
    name = "hybrid"
    type = "dual"
    1, 2, 3, 4, 5
};

io.println("Array length: " + str(obj.len(hybrid)));
io.println("Member count: " + str(obj.members(hybrid)));
assert(obj.len(hybrid) == 5);
assert(obj.members(hybrid) == 2);

var sum = 0;
obj.foreach(hybrid, [sum](value, index) {
    sum += value;
});
io.println("Array sum: " + str(sum));
assert(sum == 15);

io.println("Members:");
obj.pairs(hybrid, [](key, value) {
    io.println("  " + key + " = " + str(value));
});

var array_only = { 10, 20, 30, 40 };
assert(obj.len(array_only) == 4);
assert(obj.members(array_only) == 0);

var member_only = {
    a = 1
    b = 2
    c = 3
};
assert(obj.len(member_only) == 0);
assert(obj.members(member_only) == 3);

var builder = {};
for var i = 0; i < 5; ++i
    builder += { i * 2 };
    
io.println("Built array length: " + str(obj.len(builder)));
assert(obj.len(builder) == 5);

var obj1 = { x = 10, y = 20 };
var obj2 = { z = 30, w = 40 };
var joined = obj1 + obj2;

io.println("Joined members: " + str(obj.members(joined)));
assert(obj.members(joined) == 4);
assert(joined.x == 10);
assert(joined.z == 30);

var mutable = { a = 1 };
mutable += { b = 2 };
mutable += { c = 3 };
assert(obj.members(mutable) == 3);

mutable -= "b";
assert(obj.members(mutable) == 2);
assert(type(mutable.b) == "nil");

var complex = {
    metadata = { version = 1, author = "test" }
    data = { 100, 200, 300 }
    count = 42
};

assert(obj.members(complex) == 3);
assert(obj.len(complex.data) == 3);
assert(complex.metadata.version == 1);

var nested_foreach = 0;
obj.foreach(complex.data, [nested_foreach](val, idx) {
    nested_foreach += val;
});
io.println("Nested foreach sum: " + str(nested_foreach));
assert(nested_foreach == 600);

io.println("TEST PASSED");
