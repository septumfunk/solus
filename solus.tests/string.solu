assert('abc'.len() == 3);

assert('banana'.sub(2, 4) == nan.str());
assert('a'.repeat(5) == 'aaaaa');

val a = 'tacocat';
io.println(a.reverse());
assert(a.reverse() == a);

io.println({'solus', 'is', 'awesome'}.join(' '));
io.println('hello'.split('').reverse().join());

assert('A'.ord() == 65);

val low = "aaa";
val up = "AAA";
assert(low.upper() == up and up.lower() == low);