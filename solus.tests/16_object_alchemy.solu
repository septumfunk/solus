# Test: Object Alchemy - Complex object manipulation with obj module
# Tests: obj.get, obj.set, obj.pairs, obj.foreach, non-identifier keys

var dynamic_obj = obj.new();

io.println("Testing non-identifier keys:");
obj.set(dynamic_obj, "normal_key", 100);
obj.set(dynamic_obj, "key with spaces", 200);
obj.set(dynamic_obj, "key-with-dashes", 300);
obj.set(dynamic_obj, "123numeric", 400);
obj.set(dynamic_obj, "!@#special", 500);

assert(dynamic_obj.normal_key == 100);
assert(obj.get(dynamic_obj, "key with spaces") == 200);
assert(obj.get(dynamic_obj, "key-with-dashes") == 300);
assert(obj.get(dynamic_obj, "123numeric") == 400);
assert(obj.get(dynamic_obj, "!@#special") == 500);

io.println("Members with special keys: " + str(obj.members(dynamic_obj)));
assert(obj.members(dynamic_obj) == 5);

io.println("Testing dynamic key generation:");
var data_store = {};
for var i = 0; i < 10; ++i {
    var key = "item_" + str(i);
    obj.set(data_store, key, i * 10);
}

assert(obj.members(data_store) == 10);
assert(obj.get(data_store, "item_5") == 50);
assert(obj.get(data_store, "item_9") == 90);

io.println("Testing pairs iteration:");
var pair_sum = 0;
obj.pairs(data_store, [pair_sum](key, value) {
    pair_sum += value;
});
io.println("Sum from pairs: " + str(pair_sum));
assert(pair_sum == 450);

io.println("Testing object builder pattern:");
var build_object = [](specs) {
    var result = obj.new();
    obj.foreach(specs, [result](spec, idx) {
        obj.set(result, spec.key, spec.value);
    });
    result
};

var specs = {
    { key = "name", value = "test" },
    { key = "count", value = 42 },
    { key = "active", value = true }
};

var built = build_object(specs);
assert(built.name == "test");
assert(built.count == 42);
assert(built.active == true);

io.println("Testing object cloning:");
var clone_object = [](source) {
    var target = obj.new();
    obj.pairs(source, [target](key, value) {
        obj.set(target, key, value);
    });
    target
};

var original = { x = 10, y = 20, z = 30 };
var cloned = clone_object(original);
assert(cloned.x == 10);
assert(cloned.y == 20);

cloned.x = 100;
assert(original.x == 10);
assert(cloned.x == 100);

io.println("Testing object merging:");
var merge_objects = [clone_object](obj1, obj2) {
    var result = clone_object(obj1);
    obj.pairs(obj2, [result](key, value) {
        obj.set(result, key, value);
    });
    result
};
io.println(merge_objects);

var base = { a = 1, b = 2 };
var extension = { c = 3, d = 4 };
var merged = merge_objects(base, extension);
assert(obj.members(merged) == 4);

io.println("Testing key existence checking:");
var has_key = [](o, key) {
    var found = false;
    obj.pairs(o, [found, key](k, v) {
        if k == key
            found = true;
    });
    found
};

var test_obj = { alpha = 1, beta = 2, gamma = 3 };
assert(has_key(test_obj, "alpha") == true);
assert(has_key(test_obj, "delta") == false);

io.println("Testing object filtering:");
var filter_object = [](o, predicate) {
    var result = obj.new();
    obj.pairs(o, [result, predicate](key, value) {
        if predicate(key, value)
            obj.set(result, key, value);
    });
    result
};

var numbers_obj = { a = 10, b = 25, c = 30, d = 15 };
var filtered = filter_object(numbers_obj, [](k, v) { v > 20 });
assert(obj.members(filtered) == 2);

io.println("Testing object transformation:");
var transform_values = [](o, transformer) {
    var result = obj.new();
    obj.pairs(o, [result, transformer](key, value) {
        obj.set(result, key, transformer(value));
    });
    result
};

var numbers = { a = 1, b = 2, c = 3 };
var doubled_obj = transform_values(numbers, [](v) { v * 2 });
assert(doubled_obj.a == 2);
assert(doubled_obj.b == 4);
assert(doubled_obj.c == 6);

io.println("Testing nested object access:");
var nested = {
    level1 = {
        level2 = {
            level3 = {
                value = 999
            }
        }
    }
};

var deep_get = [](o, path) {
    var current = o;
    obj.foreach(path, [current, path](key, i) {
        current = obj.get(current, key);
    });
    current
};

var path = { "level1", "level2", "level3", "value" };
var deep_value = deep_get(nested, path);
io.println("Deep value: " + str(deep_value));
assert(deep_value == 999);

io.println("Testing object stringification:");
var stringify_test = { x = 100, y = 200, z = 300 };
var stringified = obj.stringify(stringify_test);
io.println("Stringified: " + stringified);
assert(type(stringified) == "str");

io.println("TEST PASSED");
