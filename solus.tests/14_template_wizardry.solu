# Test: Template Wizardry - Testing obj.template for custom stringification
# Tests: obj.template, obj.stringify, metaobject behavior, lazy evaluation

var person = {
    first = "John"
    last = "Doe"
    age = 30
    
    full_name = obj.template([self]() {
        self.first + " " + self.last
    })
};

io.println("Person: " + obj.stringify(person));
io.println("Full name template: " + str(person.full_name));

person.first = "Jane";
io.println("After name change: " + str(person.full_name));

var counter_with_template = {
    count = 0
    
    increment = [self]() {
        self.count += 1;
    }
    
    status = obj.template([self]() {
        "Counter is at: " + str(self.count)
    })
};

io.println("Initial status: " + str(counter_with_template.status));
counter_with_template.increment();
counter_with_template.increment();
io.println("After increments: " + str(counter_with_template.status));

var computed_properties = {
    width = 10
    height = 20
    
    area = obj.template([self]() {
        str(self.width * self.height)
    })
    
    perimeter = obj.template([self]() {
        str(2 * (self.width + self.height))
    })
};

io.println("Area: " + str(computed_properties.area));
io.println("Perimeter: " + str(computed_properties.perimeter));

computed_properties.width = 15;
io.println("After width change - Area: " + str(computed_properties.area));
io.println("After width change - Perimeter: " + str(computed_properties.perimeter));

var lazy_calculator = {
    a = 5
    b = 10
    
    sum = obj.template([self]() {
        io.println("Computing sum...");
        str(self.a + self.b)
    })
    
    product = obj.template([self]() {
        io.println("Computing product...");
        str(self.a * self.b)
    })
};

io.println("First sum access: " + str(lazy_calculator.sum));
io.println("Second sum access: " + str(lazy_calculator.sum));

var nested_templates = {
    data = {
        x = 100
        y = 200
        
        combined = obj.template([self]() {
            str(self.x + self.y)
        })
    }
    
    description = obj.template([self]() {
        "Data combined value: " + str(self.data.combined)
    })
};

io.println("Nested template: " + str(nested_templates.description));
nested_templates.data.x = 150;
io.println("After nested change: " + str(nested_templates.description));

var time_tracker = {
    start_time = 0
    current_time = 0
    
    elapsed = obj.template([self]() {
        str(self.current_time - self.start_time) + " seconds"
    })
    
    start = [self]() {
        self.start_time = self.current_time;
    }
    
    tick = [self]() {
        self.current_time += 1;
    }
};

time_tracker.start();
io.println("Initial elapsed: " + str(time_tracker.elapsed));

for var i = 0; i < 5; ++i
    time_tracker.tick();

io.println("After 5 ticks: " + str(time_tracker.elapsed));

var format_builder = [](prefix, suffix) {
    {
        value = 0
        
        formatted = obj.template([self, prefix, suffix]() {
            prefix + str(self.value) + suffix
        })
        
        set = [self](v) {
            self.value = v;
        }
    }
};

var currency = format_builder("$", " USD");
currency.set(100);
io.println("Currency: " + str(currency.formatted));

currency.set(250);
io.println("Updated currency: " + str(currency.formatted));

var complex_template = {
    items = { 1, 2, 3, 4, 5 }
    multiplier = 2
    
    processed = obj.template([self]() {
        var result = "";
        var sum = 0;
        obj.foreach(self.items, [sum, self](val, idx) {
            sum += val * self.multiplier;
        });
        "Total: " + str(sum)
    })
};

io.println("Complex template: " + str(complex_template.processed));
complex_template.multiplier = 3;
io.println("After multiplier change: " + str(complex_template.processed));

io.println("TEST PASSED");
