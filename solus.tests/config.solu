let default = {
    repeat = 5
    min_i = -256
    max_i = 256
};

let cfg = attempt([]() {
    let f = io.fread("solus.tests/test.cfg");
    if type(f) == "err": f
    else: eval(f)
}, [default]() {
    unwrap(io.fwrite("solus.tests/test.cfg", obj.stringify(default, false)));
    default
});

let x = 0;
while x < cfg.repeat: {
    io.println(math.randi(cfg.min_i, cfg.max_i));
    x += 1;
}