val default = {
    repeat = 5
    min_i = -256
    max_i = 256
};

val cfg = attempt([]() {
    val f = io.fread("solus.tests/test.cfg");
    type(f) == "err" and f or eval(f)
}, [default]() {
    unwrap(io.fwrite("solus.tests/test.cfg", obj.stringify(default, false)));
    default
});

var x = 0;
while x < cfg.repeat {
    io.println(math.randi(cfg.min_i, cfg.max_i));
    x += 1;
}