# Test: Y-Combinator - Fixed-point combinator for anonymous recursion
# Tests: Higher-order functions, closures, deep upvalue capture, recursion

var Y = [](f) {
    [f](x) { f([x](v) { x(x)(v) }) }(
        [f](x) { f([x](v) { x(x)(v) }) }
    )
};

var factorial = Y([](recurse) {
    [recurse](n) {
        n <= 1 and 1 or n * recurse(n - 1)
    }
});

io.println("Factorial(5): " + str(factorial(5)));
io.println("Factorial(10): " + str(factorial(10)));
assert(factorial(5) == 120);
assert(factorial(10) == 3628800);

var fibonacci = Y([](recurse) {
    [recurse](n) {
        n <= 1 and n or recurse(n - 1) + recurse(n - 2)
    }
});

io.println("Fibonacci(10): " + str(fibonacci(10)));
io.println("Fibonacci(15): " + str(fibonacci(15)));
assert(fibonacci(10) == 55);
assert(fibonacci(15) == 610);

var ackermann = Y([](recurse) {
    [recurse](m, n) {
        m == 0 and n + 1 or (
            n == 0 and recurse(m - 1, 1) or recurse(m - 1, recurse(m, n - 1))
        )
    }
});

io.println("Ackermann(1, 2): " + str(ackermann(1, 2)));
io.println("Ackermann(2, 3): " + str(ackermann(2, 3)));
io.println("Ackermann(3, 2): " + str(ackermann(3, 2)));
assert(ackermann(1, 2) == 4);
assert(ackermann(2, 3) == 9);
assert(ackermann(3, 2) == 29);

io.println("TEST PASSED");
