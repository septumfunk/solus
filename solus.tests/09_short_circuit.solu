# Test: Short-Circuit Sorcery - Testing and/or short-circuit behavior
# Tests: and, or, &&, ||, short-circuit evaluation, side effects

var call_count = 0;

var side_effect = [call_count]() {
    call_count += 1;
    io.println(call_count);
    42
};

var test1 = false and side_effect();
io.println("Test 1 call count: " + str(call_count));
assert(call_count == 0);
assert(test1 == false);

call_count = 0;
var test2 = true or side_effect();
io.println("Test 2 call count: " + str(call_count));
assert(call_count == 0);
assert(test2 == true);

call_count = 0;
var test3 = true and side_effect();
io.println("Test 3 call count: " + str(call_count));
assert(call_count == 1);
assert(test3 == 42);

call_count = 0;
var test4 = false or side_effect();
io.println("Test 4 call count: " + str(call_count));
assert(call_count == 1);
assert(test4 == 42);

var safe_divide = [](a, b) {
    b != 0 and a / b or err("division by zero")
};

var div1 = safe_divide(10, 2);
assert(div1 == 5);

var div2 = safe_divide(10, 0);
assert(type(div2) == "err");

var get_default = [](maybe_val, default) {
    type(maybe_val) != "err" and maybe_val or default
};

assert(get_default(100, -1) == 100);
assert(get_default(err("oops"), -1) == -1);

var chain = [](a, b, c, d) {
    a and b and c and d
};

assert(chain(true, true, true, true) == true);
assert(chain(true, true, false, true) == false);
assert(chain(true, false, true, true) == false);

var or_chain = [](a, b, c, d) {
    a or b or c or d
};

assert(or_chain(false, false, false, true) == true);
assert(or_chain(false, false, false, false) == false);
assert(or_chain(true, false, false, false) == true);

var mixed_chain = [](a, b, c, d) {
    (a or b) and (c or d)
};

assert(mixed_chain(true, false, true, false) == true);
assert(mixed_chain(true, false, false, false) == false);
assert(mixed_chain(false, false, true, false) == false);

var counter = 0;
var counted_true = [counter]() { counter += 1; true };
var counted_false = [counter]() { counter += 1; false };

counter = 0;
var result1 = counted_true() and counted_true() and counted_true();
io.println("Counter after true chain: " + str(counter));
assert(counter == 3);

counter = 0;
var result2 = counted_false() and counted_true() and counted_true();
io.println("Counter after false then true: " + str(counter));
assert(counter == 1);

counter = 0;
var result3 = counted_false() or counted_false() or counted_true();
io.println("Counter after or chain: " + str(counter));
assert(counter == 3);

var nullable_chain = [](obj, key1, key2, default) {
    type(obj) != "nil" and
    type(obj[key1]) != "nil" and
    type(obj[key1][key2]) != "nil" and
    obj[key1][key2] or default
};

var test_obj = {
    level1 = {
        level2 = 100
    }
};

var chain_result = nullable_chain(test_obj, "level1", "level2", -1);
io.println("Nullable chain result: " + str(chain_result));
assert(chain_result == 100);

var chain_result2 = nullable_chain(test_obj, "missing", "level2", -1);
assert(chain_result2 == -1);

var truthy_values = []() {
    1 and "string" and 3.14 and true
};

var last_truthy = truthy_values();
io.println("Last truthy value type: " + type(last_truthy));
assert(last_truthy == true);

var first_falsy = []() {
    1 and "string" and false and "never"
};

assert(first_falsy() == false);

io.println("TEST PASSED");
