# Test: Do-Block Alchemy - Testing do expressions and trailing returns
# Tests: do blocks, trailing returns, expression evaluation, scoping

var result1 = do {
    var x = 10;
    var y = 20;
    x + y
};

io.println("Do block result 1: " + str(result1));
assert(result1 == 30);

var result2 = do {
    var temp = 5;
    temp *= 4;
    temp += 10;
    temp / 2
};

io.println("Do block result 2: " + str(result2));
assert(result2 == 15);

var conditional_do = [](condition) {
    condition and do {
        var success = true;
        var value = 42;
        value
    } or do {
        var failure = true;
        var value = -1;
        value
    }
};

assert(conditional_do(true) == 42);
assert(conditional_do(false) == -1);

var nested_do = do {
    var outer = 100;
    do {
        var inner = 200;
        do {
            var innermost = 300;
            outer + inner + innermost
        }
    }
};

io.println("Nested do result: " + str(nested_do));
assert(nested_do == 600);

var complex_calc = [](a, b, c) {
    do {
        var step1 = a * 2;
        var step2 = b + 10;
        var step3 = c - 5;
        do {
            var intermediate = step1 + step2;
            do {
                var final = intermediate * step3;
                final
            }
        }
    }
};

var calc_result = complex_calc(5, 10, 15);
io.println("Complex calc: " + str(calc_result));
assert(calc_result == 300);

var factorial_do = [](n) {
    n <= 1 and 1 or do {
        var result = 1;
        for var i = 2; i <= n; ++i
            result *= i;
        result
    }
};

assert(factorial_do(5) == 120);
assert(factorial_do(1) == 1);
assert(factorial_do(0) == 1);

var function_with_do = [](x) {
    var prefix = "Result: ";
    prefix + str(do {
        x *= 2;
        x += 10;
        x
    })
};

var str_result = function_with_do(15);
io.println(str_result);
assert(str_result == "Result: 40");

var array_from_do = {
    do { 1 + 1 },
    do { 2 + 2 },
    do { 3 + 3 },
    do { var x = 4; x + x }
};

assert(obj.len(array_from_do) == 4);
var sum_do = 0;
obj.foreach(array_from_do, [sum_do](val, idx) {
    sum_do += val;
});
assert(sum_do == 20);

var object_with_do = {
    value = do {
        var base = 50;
        base * 2
    }
    computed = do {
        var a = 10;
        var b = 20;
        a + b
    }
};

assert(object_with_do.value == 100);
assert(object_with_do.computed == 30);

var no_trailing_return = do {
    var x = 100;
    x += 50;
};

io.println("No trailing return type: " + type(no_trailing_return));
assert(type(no_trailing_return) == "nil");

io.println("TEST PASSED");
