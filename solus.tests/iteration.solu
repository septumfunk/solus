# tests/new_obj_methods.sol

val xs = { 10, 15, 20, 25, 30 };

io.println('--- len ---');
io.println(xs.len());              # expect 5

io.println('--- foreach ---');
xs.foreach([](value, i) {
    io.println($'{i}: {value}');
});
# expect:
# 0: 10
# 1: 15
# 2: 20
# 3: 25
# 4: 30

io.println('--- where (first truthy callback result) ---');
val first_over_18 = xs.where([](value, i) {
    if value > 18
        value
    nil
});
io.println(first_over_18);         # expect 20

io.println('--- all with mapped values ---');
val labels = xs.all([](value, i) {
    if value >= 20
        $'idx={i}, val={value}'
    nil
});
io.println(labels);                # expect { 'idx=2, val=20', 'idx=3, val=25', 'idx=4, val=30' }

io.println('--- range ---');
val mid = xs.range(1, 3);
io.println(mid);                   # expect { 15, 20, 25 }

io.println('--- reverse ---');
val rev = xs.reverse();
io.println(rev);                   # expect { 30, 25, 20, 15, 10 }

io.println('--- contains ---');
io.println(xs.contains(20));       # expect true
io.println(xs.contains(999));      # expect false

io.println('--- object has ---');
val person = {
    name = 'DJ'
    age = 21
};
io.println(person.has('name'));    # expect true
io.println(person.has('zzz'));     # expect false

io.println('--- object find over members ---');
val found = person.find([](key, value) {
    if key == 'age'
        value
    nil
});
io.println(found);                 # expect 21

io.println('--- object match over members ---');
val selected = person.match([](key, value) {
    if key == 'name'
        value
    nil
});
io.println(selected);              # expect { 'DJ' } or equivalent