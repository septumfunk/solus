var pos = { 15, 0 }.usemeta({
    _add = [](a, b) {
        { a[0] + b[0], a[1] + b[1] }
    }
    _get = [](o, key) {
        if key == 'x'
            o[0]
        if key == 'y'
            o[1]
        obj.getr(o, key)
    }
});
assert(pos.x == 15);
assert(eval(pos.stringify(false)).unwrap()[0] == pos.x);

assert({1, 2, 3, 4, 5}.reverse()[0] == 5);

io.println({
    x = 2
    formatted = obj.template([self]() $"'{{x = {self.x}}}'")
}.stringify(false, true));

var o = {
    a = 1
    b = 2
    c = 3
};
obj.pairs(o, [](key, value) io.println($'{key} = {value}'));

io.println({
    a = 2.2
    b = 4
}.find([](k, v) v.type() == 'f64'));

io.println({
    a = 2.2
    b = 4
    c = 3.14
}.match([](k, v) v.type() == 'f64').stringify(false));

o = {x = 2};
assert(o.has('x'));
o -= 'x';
assert(!o.has('x'));

o = {};
for var i = 0; i < 5; ++i
    o.push(i + 1);
io.println(o.stringify(false));

o = {};
for var i = 0; i < 5; ++i
    o.push_back(i + 1);
io.println(o.stringify(false));

o = { 1, 2, 3, 4, 5 };
for var i = 0; i < o.len(); ++i
    io.println(o.pop());

o = { 1, 2, 3, 4, 5 };
for var i = 0; i < o.len(); ++i
    io.println(o.pop_back());

o = { 1, 2, 3, 4, 5 };
o.remove(2);
for var i = 0; i < o.len(); ++i
    io.println(o.pop_back());

o = { 1, 2, 3, 4, 5 };
obj.foreach(o, [](value, i) io.println(value));

io.println({1, 2, 3, 4, 5}.reverse().stringify(false));
io.println({1, 2, 3, 4, 5}.range(1, 3).stringify(false));

io.println({1, nil, nan, 2.2}.where([](v) v.type() == 'f64'));
io.println({3.14, nil, nan, 2.2}.all([](v) v.type() == 'f64').stringify(false));