{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI",
      "request": "launch",
      "program": "${workspaceFolder:solus}/build/solus",
      "args": ["${input:cliMode}", "solus.tests/${input:scriptName}"],
      "cwd": "${workspaceFolder:solus}",
      "terminal": "integrated",

      // Defaults (Linux/macOS)
      "type": "lldb",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0:disable_coredump=0",
        "LSAN_OPTIONS": "detect_leaks=0"
      },

      // Windows overrides
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder:solus}/build/solus.exe",
        "args": ["${input:cliMode}", "solus.tests/${input:scriptName}"],
      }
    },
    {
      "name": "Sanitize CLI",
      "request": "launch",
      "cwd": "${workspaceFolder:solus}",
      "args": ["${input:cliMode}", "solus.tests/${input:scriptName}"],
      "type": "lldb",
      "program": "${workspaceFolder:solus}/build/sanitized/solus",
      "terminal": "integrated",

      "env": {
        "ASAN_OPTIONS": "detect_leaks=0:disable_coredump=0",
        "LSAN_OPTIONS": "detect_leaks=0"
      },

      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder:solus}/build/sanitized/solus.exe",
        "args": ["${input:cliMode}", "solus.tests/${input:scriptName}"],
        "cwd": "${workspaceFolder:solus}"
      }
    },
    {
      "name": "Run Tests",
      "request": "launch",
      "program": "${workspaceFolder:solus}/build/solus",
      "args": ["test", "solus.tests"],
      "cwd": "${workspaceFolder:solus}",

      // Defaults (Linux/macOS)
      "type": "lldb",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0:disable_coredump=0",
        "LSAN_OPTIONS": "detect_leaks=0"
      },

      // Windows overrides
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder:solus}/build/solus.exe",
        "args": ["test", "solus.tests"],
      }
    }
  ],

  "inputs": [
    {
      "id": "cliMode",
      "type": "promptString",
      "description": "CLI Mode",
      "default": "run"
    },
    {
      "id": "scriptName",
      "type": "promptString",
      "description": "Script Name",
      "default": "default"
    }
  ]
}
